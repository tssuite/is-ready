{
  "name": "@tssuite/is-ready",
  "version": "0.0.2",
  "description": "Wait for things to become ready",
  "homepage": "https://github.com/tssuite/is-ready",
  "bugs": "https://github.com/tssuite/is-ready/issues",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tssuite/is-ready.git"
  },
  "main": "dist/is-ready.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "vite build && tsc && node dna/scripts/copy-readme-to-dist.js && node dna/scripts/copy-example-to-dist.js",
    "test": "vitest run --coverage && pnpm run lint",
    "prebuild": "npm run test",
    "prepublishOnly": "npm run build",
    "lint": "eslint",
    "updateGoldens": "cross-env UPDATE_GOLDENS=true pnpm test"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.11.0",
    "jsdoc": "^4.0.5",
    "read-pkg": "^10.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-node": "^6.0.0",
    "vite-plugin-dts": "^5.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "vitest-dom": "^0.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.11.0"
}
